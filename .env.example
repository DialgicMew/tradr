# tradr — example environment. `start.sh` copies this to .env on first run.
# NEVER commit .env. All PERSONAL config (budget, tiers, holdings) is entered in the
# UI, not here — this file holds only infrastructure settings.

# --- Database ---
# Default: SQLite. Zero setup — the file is created automatically on first run.
DATABASE_URL=sqlite+pysqlite:///./tradr.db
#
# For a persistent Postgres deployment (see docker-compose.yml), comment the line
# above and uncomment these:
# POSTGRES_USER=tradr
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=tradr
# DATABASE_URL=postgresql+psycopg://tradr:change-me@localhost:5432/tradr

# --- Market data ---
# yahoo = free live prices, no API key (unofficial, can rate-limit).
# none  = offline (no prices) — useful for tests or exploring the UI first.
MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_API_KEY=

# --- Telegram bot (optional; long-polling, no inbound port needed) ---
# Create a bot via @BotFather, then get your numeric chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- App (bind to localhost only; reach the UI via Tailscale or an SSH tunnel) ---
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
